{
  "openapi": "3.1.0",
  "info": {
    "title": "WX Wallet API",
    "version": "0.3.0",
    "description": "서울 기준 WX 장부 조회. HYPHEN 시험 전 기관 송금과 예금주 조회는 접수 중지."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:{port}",
      "variables": {
        "port": {
          "default": "18099"
        }
      }
    }
  ],
  "security": [
    {
      "WalletKey": []
    }
  ],
  "paths": {
    "/api/v1/wallet/balance": {
      "post": {
        "operationId": "balance",
        "summary": "Wallet 잔액 조회",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "walletId"
                ],
                "properties": {
                  "walletId": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Wallet 잔액 조회 성공",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "result",
                    "data",
                    "traceId"
                  ],
                  "properties": {
                    "result": {
                      "const": true
                    },
                    "traceId": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9]{8}$"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "walletId": {
                          "type": "string"
                        },
                        "balance": {
                          "type": "integer"
                        },
                        "held": {
                          "type": "integer"
                        },
                        "reserved": {
                          "type": "integer"
                        },
                        "available": {
                          "type": "integer"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "필드·값 형식 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "인증키 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "접속 주소 미허용",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "조회 대상 없음",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "허용되지 않은 메서드",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "8,192바이트 초과",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "JSON 콘텐츠 형식 필요",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "기관 접수 중지 또는 원장 연결 실패",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/wallet/inquiry": {
      "post": {
        "operationId": "inquiry",
        "summary": "송금 장부 결과 조회",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "trxId"
                ],
                "properties": {
                  "trxId": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "송금 장부 결과 조회 성공",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "result",
                    "data",
                    "traceId"
                  ],
                  "properties": {
                    "result": {
                      "const": true
                    },
                    "traceId": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9]{8}$"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "trxId": {
                          "type": "string"
                        },
                        "trackId": {
                          "type": "string"
                        },
                        "walletId": {
                          "type": "string"
                        },
                        "amount": {
                          "type": "integer"
                        },
                        "status": {
                          "type": "string"
                        },
                        "requestAt": {
                          "type": "string"
                        },
                        "completedAt": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "필드·값 형식 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "인증키 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "접속 주소 미허용",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "조회 대상 없음",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "허용되지 않은 메서드",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "8,192바이트 초과",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "JSON 콘텐츠 형식 필요",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "기관 접수 중지 또는 원장 연결 실패",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/wallet/transfer": {
      "post": {
        "operationId": "transfer",
        "summary": "송금 접수 중지",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "walletId",
                  "requestId",
                  "amount",
                  "bankCode",
                  "account",
                  "recipient"
                ],
                "properties": {
                  "walletId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "requestId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "amount": {
                    "type": "string",
                    "pattern": "^[1-9][0-9]{0,11}$"
                  },
                  "bankCode": {
                    "type": "string",
                    "minLength": 1
                  },
                  "account": {
                    "type": "string",
                    "minLength": 1
                  },
                  "recipient": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        "responses": {
          "400": {
            "description": "필드·값 형식 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "인증키 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "접속 주소 미허용",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "조회 대상 없음",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "허용되지 않은 메서드",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "8,192바이트 초과",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "JSON 콘텐츠 형식 필요",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "기관 접수 중지 또는 원장 연결 실패",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/wallet/holder": {
      "post": {
        "operationId": "holder",
        "summary": "예금주 조회 접수 중지",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "walletId",
                  "requestId",
                  "bankCode",
                  "account"
                ],
                "properties": {
                  "walletId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "requestId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "bankCode": {
                    "type": "string",
                    "minLength": 1
                  },
                  "account": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        "responses": {
          "400": {
            "description": "필드·값 형식 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "인증키 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "접속 주소 미허용",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "조회 대상 없음",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "허용되지 않은 메서드",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "8,192바이트 초과",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "JSON 콘텐츠 형식 필요",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "기관 접수 중지 또는 원장 연결 실패",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "WalletKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-WX-Key",
        "description": "환경이 일치하는 WX의 활성 키와 고객사 등록 IP로 확인한다. NGINX가 고객사 접속 주소를 X-Forwarded-For에 한 개 설정하고 TX24_HTTP가 INet으로 전달한다. 기본 키 환경은 live다."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "result",
          "code",
          "message",
          "traceId"
        ],
        "properties": {
          "result": {
            "const": false
          },
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "traceId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9]{8}$"
          }
        }
      }
    }
  }
}

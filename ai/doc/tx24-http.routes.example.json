{
  "routes": {
    "/api/v1/wallet/balance": {
      "lb": "WX_API",
      "target": "/api/v1/wallet/balance",
      "charset": "UTF-8",
      "methods": "POST",
      "headers": [
        "authorization",
        "x-trace-id"
      ],
      "timeoutMillis": 8000,
      "maxConcurrent": 64
    },
    "/api/v1/wallet/inquiry": {
      "lb": "WX_API",
      "target": "/api/v1/wallet/inquiry",
      "charset": "UTF-8",
      "methods": "POST",
      "headers": [
        "authorization",
        "x-trace-id"
      ],
      "timeoutMillis": 8000,
      "maxConcurrent": 64
    },
    "/api/v1/wallet/transfer": {
      "lb": "WX_API",
      "target": "/api/v1/wallet/transfer",
      "charset": "UTF-8",
      "methods": "POST",
      "headers": [
        "authorization",
        "x-trace-id"
      ],
      "timeoutMillis": 8000,
      "maxConcurrent": 64
    },
    "/api/v1/wallet/holder": {
      "lb": "WX_API",
      "target": "/api/v1/wallet/holder",
      "charset": "UTF-8",
      "methods": "POST",
      "headers": [
        "authorization",
        "x-trace-id"
      ],
      "timeoutMillis": 8000,
